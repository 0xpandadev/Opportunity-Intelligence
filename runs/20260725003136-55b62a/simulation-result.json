  "report": {
    "executive_summary": "結論は「東京タワマン全体を買う」ではなく、棟別に買う・待つ・避けるを分けること。基準ケースは品質差の拡大。金利ショックでは高LTV・非中核・修繕弱含み棟から流動性が崩れ、現金・低LTV資金は管理良好な希少棟へ集中する。優位性は相場予言ではなく、管理・修繕・防災・実質利回り・出口を証拠台帳で審査し、反証条件で配分を変える能力にある。",
    "robust_actions": [
      "固定3.5%・価格15%下落・修繕30%増を棟別ストレス",
      "議事録・長期修繕・積立・防災を価格交渉前に確認",
      "在庫日数・指値幅・成約を月次監視",
      "反証指標付き段階取得"
    ],
    "contingent_actions": [
      "金利3.5%以上かつ成約15%減なら高LTV・低流動性棟を除外",
      "供給減と契約率上昇が同時なら希少棟を再評価",
      "品質連動融資が普及したら改善余地棟を再評価"
    ],
    "avoid": [
      "平均上昇率だけで買う",
      "表面利回りだけで判断",
      "合成確率を利益保証扱い",
      "ブランドで修繕調査を省略"
    ]
  },
  "limitations": [
    "CodexによるMiroFish方法論参照の合成シミュレーションで、MiroFish上流ランタイムや実在主体調査ではない。",
    "効用・相互作用・確率はsynthetic weightで統計推定値ではない。",
    "棟別成約・議事録・積立残高・外国資金の完全データはない。",
    "投資助言・利益保証ではなく意思決定ストレステスト。"
  ]
}
